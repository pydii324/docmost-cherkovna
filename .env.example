# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32
#
# IMPORTANT: keep every comment on its own line. Values here are also read by
# `docker run --env-file`, which does NOT strip trailing comments the way
# docker compose does -- an inline comment becomes part of the value.

APP_URL=https://docs.example.com
APP_SECRET=CHANGE_ME_openssl_rand_hex_32

DATABASE_URL=postgresql://docmost:CHANGE_ME@db:5432/docmost?schema=public
REDIS_URL=redis://redis:6379

POSTGRES_DB=docmost
POSTGRES_USER=docmost
# POSTGRES_PASSWORD must match the password inside DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME

MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
# Gmail: an App Password, not the account password
SMTP_PASSWORD=CHANGE_ME
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME=Docmost

# Public draw.io works too: https://embed.diagrams.net
DRAWIO_BASEURL=https://draw.example.com

# --- Garage ----------------------------------------------------------------
# 32-byte hex, shared between cluster nodes. Single node here, but still required.
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- storage ---------------------------------------------------------------
# local = docmost volume at /app/data/storage; s3 = the garage service in compose
STORAGE_DRIVER=s3

# Garage creates this key and bucket on first boot from these exact values
# (server --single-node --default-bucket). Key ID: >= 8 chars, [A-Za-z0-9-_.].
# Secret: >= 16 printable ASCII chars. The GK prefix is convention only.
AWS_S3_ACCESS_KEY_ID=GKCHANGEME000000
AWS_S3_SECRET_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_32
# AWS_S3_REGION must match s3_region in garage.toml
AWS_S3_REGION=garage
AWS_S3_BUCKET=docmost
AWS_S3_ENDPOINT=http://garage:3900
# Literal string "true" -- Docmost compares it as a string. Garage always allows path-style.
AWS_S3_FORCE_PATH_STYLE=true

# --- later: moving to an external S3 ---------------------------------------
# Replace the six AWS_S3_* values, delete the garage service, garage.toml and
# the garage_meta / garage_data volumes.
# Hetzner:   REGION=fsn1  ENDPOINT=https://fsn1.your-objectstorage.com  PATH_STYLE=true
# R2:        REGION=auto  ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  PATH_STYLE=true
# AWS S3:    REGION=eu-central-1  ENDPOINT=  (empty)  PATH_STYLE=false
